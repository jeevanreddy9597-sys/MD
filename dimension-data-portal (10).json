    "methods": {
        "getSelectedDimension": {
            "description": "Returns selected dimension ID",
            "returnType": "string"
        },
        "getRowCount": {
            "description": "Returns clean row count",
            "returnType": "integer"
        },
        "getRowId": {
            "description": "Returns ID at index",
            "returnType": "string",
            "parameters": [
                {
                    "name": "index",

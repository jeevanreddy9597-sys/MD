{
  "id": "com.sac.masterdatauploader",
  "version": "1.0.0",
  "name": "Master Data Uploader",
  "description": "Upload CSV master data and save members to an SAC planning model through Analytic Application scripting.",
  "newInstancePrefix": "MasterDataUploader",
  "vendor": "Custom",
  "icon": "",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-sac-masterdatauploader",
      "url": "/master-data-uploader.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-sac-masterdatauploader-styling",
      "url": "/master-data-uploader.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "tenantUrl": {
      "type": "string",
      "description": "SAC tenant URL",
      "default": ""
    },
    "modelId": {
      "type": "string",
      "description": "Planning model ID",
      "default": ""
    },
    "dim1Config": {
      "type": "string",
      "description": "Dimension 1 JSON configuration",
      "default": ""
    },
    "dim2Config": {
      "type": "string",
      "description": "Dimension 2 JSON configuration",
      "default": ""
    },
    "dim3Config": {
      "type": "string",
      "description": "Dimension 3 JSON configuration",
      "default": ""
    },
    "dim4Config": {
      "type": "string",
      "description": "Dimension 4 JSON configuration",
      "default": ""
    },
    "dim5Config": {
      "type": "string",
      "description": "Dimension 5 JSON configuration",
      "default": ""
    },
    "dim6Config": {
      "type": "string",
      "description": "Dimension 6 JSON configuration",
      "default": ""
    },
    "dim7Config": {
      "type": "string",
      "description": "Dimension 7 JSON configuration",
      "default": ""
    },
    "dim8Config": {
      "type": "string",
      "description": "Dimension 8 JSON configuration",
      "default": ""
    },
    "dim9Config": {
      "type": "string",
      "description": "Dimension 9 JSON configuration",
      "default": ""
    },
    "dim10Config": {
      "type": "string",
      "description": "Dimension 10 JSON configuration",
      "default": ""
    },
    "dim11Config": {
      "type": "string",
      "description": "Dimension 11 JSON configuration",
      "default": ""
    },
    "dim12Config": {
      "type": "string",
      "description": "Dimension 12 JSON configuration",
      "default": ""
    },
    "dim13Config": {
      "type": "string",
      "description": "Dimension 13 JSON configuration",
      "default": ""
    },
    "dim14Config": {
      "type": "string",
      "description": "Dimension 14 JSON configuration",
      "default": ""
    },
    "dim15Config": {
      "type": "string",
      "description": "Dimension 15 JSON configuration",
      "default": ""
    },
    "dim16Config": {
      "type": "string",
      "description": "Dimension 16 JSON configuration",
      "default": ""
    },
    "dim17Config": {
      "type": "string",
      "description": "Dimension 17 JSON configuration",
      "default": ""
    },
    "dim18Config": {
      "type": "string",
      "description": "Dimension 18 JSON configuration",
      "default": ""
    },
    "dim19Config": {
      "type": "string",
      "description": "Dimension 19 JSON configuration",
      "default": ""
    },
    "dim20Config": {
      "type": "string",
      "description": "Dimension 20 JSON configuration",
      "default": ""
    }
  },
  "methods": {
    "startImport": {
      "description": "Starts the import process and fires onStart."
    },
    "getSelectedDimension": {
      "description": "Returns the selected dimension ID.",
      "returnType": "string"
    },
    "getRowCount": {
      "description": "Returns the imported CSV row count.",
      "returnType": "integer"
    },
    "getRowFieldValue": {
      "description": "Returns a field value from an imported row.",
      "returnType": "string",
      "parameters": [
        {
          "name": "index",
          "type": "integer",
          "description": "Zero-based row index"
        },
        {
          "name": "fieldKey",
          "type": "string",
          "description": "CSV column or dimension property key"
        }
      ]
    },
    "getImportPayload": {
      "description": "Returns the complete import payload as JSON.",
      "returnType": "string"
    },
    "setRowStatus": {
      "description": "Sets the processing result for a row.",
      "parameters": [
        {
          "name": "index",
          "type": "integer",
          "description": "Zero-based row index"
        },
        {
          "name": "status",
          "type": "string",
          "description": "success, error, pending"
        },
        {
          "name": "message",
          "type": "string",
          "description": "Optional result message"
        }
      ]
    },
    "setSaveResult": {
      "description": "Sets the overall save result.",
      "parameters": [
        {
          "name": "status",
          "type": "string",
          "description": "success or error"
        },
        {
          "name": "message",
          "type": "string",
          "description": "Result message"
        }
      ]
    },
    "resetWidget": {
      "description": "Clears uploaded data and resets the widget."
    }
  },
  "events": {
    "onStart": {
      "description": "Fired when import is started."
    },
    "onSubmit": {
      "description": "Fired when the user confirms Save to Model. Use getter methods to read the data."
    },
    "onSave": {
      "description": "Fired after setSaveResult is called with success."
    },
    "onError": {
      "description": "Fired when validation or saving fails."
    }
  },
  "dataBindings": {}
}

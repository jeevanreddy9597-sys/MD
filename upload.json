{
  "id": "com.sac.masterdatauploader",
  "version": "1.0.0",
  "name": "Master Data Uploader",
  "description": "CSV master-data upload widget for SAC Planning models.",
  "newInstancePrefix": "MasterDataUploader",
  "vendor": "Custom",
  "icon": "",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-sac-masterdatauploader",
      "url": "https://jeevanreddy9597-sys.github.io/MD/Upload.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-sac-masterdatauploader-styling",
      "url": "https://jeevanreddy9597-sys.github.io/MD/Upload.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "tenantUrl": {
      "type": "string",
      "description": "SAC tenant URL",
      "default": ""
    },
    "modelId": {
      "type": "string",
      "description": "Planning model ID",
      "default": ""
    },
    "dim1Config": {
      "type": "string",
      "description": "Dimension 1 JSON configuration",
      "default": ""
    },
    "dim2Config": {
      "type": "string",
      "description": "Dimension 2 JSON configuration",
      "default": ""
    },
    "dim3Config": {
      "type": "string",
      "description": "Dimension 3 JSON configuration",
      "default": ""
    },
    "dim4Config": {
      "type": "string",
      "description": "Dimension 4 JSON configuration",
      "default": ""
    },
    "dim5Config": {
      "type": "string",
      "description": "Dimension 5 JSON configuration",
      "default": ""
    },
    "dim6Config": {
      "type": "string",
      "description": "Dimension 6 JSON configuration",
      "default": ""
    },
    "dim7Config": {
      "type": "string",
      "description": "Dimension 7 JSON configuration",
      "default": ""
    },
    "dim8Config": {
      "type": "string",
      "description": "Dimension 8 JSON configuration",
      "default": ""
    },
    "dim9Config": {
      "type": "string",
      "description": "Dimension 9 JSON configuration",
      "default": ""
    },
    "dim10Config": {
      "type": "string",
      "description": "Dimension 10 JSON configuration",
      "default": ""
    },
    "dim11Config": {
      "type": "string",
      "description": "Dimension 11 JSON configuration",
      "default": ""
    },
    "dim12Config": {
      "type": "string",
      "description": "Dimension 12 JSON configuration",
      "default": ""
    },
    "dim13Config": {
      "type": "string",
      "description": "Dimension 13 JSON configuration",
      "default": ""
    },
    "dim14Config": {
      "type": "string",
      "description": "Dimension 14 JSON configuration",
      "default": ""
    },
    "dim15Config": {
      "type": "string",
      "description": "Dimension 15 JSON configuration",
      "default": ""
    },
    "dim16Config": {
      "type": "string",
      "description": "Dimension 16 JSON configuration",
      "default": ""
    },
    "dim17Config": {
      "type": "string",
      "description": "Dimension 17 JSON configuration",
      "default": ""
    },
    "dim18Config": {
      "type": "string",
      "description": "Dimension 18 JSON configuration",
      "default": ""
    },
    "dim19Config": {
      "type": "string",
      "description": "Dimension 19 JSON configuration",
      "default": ""
    },
    "dim20Config": {
      "type": "string",
      "description": "Dimension 20 JSON configuration",
      "default": ""
    }
  },
  "methods": {
    "startImport": {
      "description": "Starts the import process and fires onStart."
    },
    "getSelectedDimension": {
      "description": "Returns selected dimension ID.",
      "returnType": "string"
    },
    "getRowCount": {
      "description": "Returns uploaded row count.",
      "returnType": "integer"
    },
    "getRowFieldValue": {
      "description": "Returns a CSV value from a selected row.",
      "returnType": "string",
      "parameters": [
        {
          "name": "index",
          "type": "integer",
          "description": "Row index"
        },
        {
          "name": "fieldKey",
          "type": "string",
          "description": "CSV header name"
        }
      ]
    },
    "getImportPayload": {
      "description": "Returns import data as JSON.",
      "returnType": "string"
    },
    "setRowStatus": {
      "description": "Sets individual row processing status.",
      "parameters": [
        {
          "name": "index",
          "type": "integer",
          "description": "Row index"
        },
        {
          "name": "status",
          "type": "string",
          "description": "pending, success, or error"
        },
        {
          "name": "message",
          "type": "string",
          "description": "Result message"
        }
      ]
    },
    "setSaveResult": {
      "description": "Sets overall save result.",
      "parameters": [
        {
          "name": "status",
          "type": "string",
          "description": "success or error"
        },
        {
          "name": "message",
          "type": "string",
          "description": "Result message"
        }
      ]
    },
    "resetWidget": {
      "description": "Clears all uploaded data."
    }
  },
  "events": {
    "onStart": {
      "description": "Fired when Start Import is selected."
    },
    "onSubmit": {
      "description": "Fired when Save to Model is selected."
    },
    "onSave": {
      "description": "Fired after a successful save result."
    },
    "onError": {
      "description": "Fired after validation or save errors."
    }
  },
  "dataBindings": {}
}
